# ============================================
# PLAID CONFIGURATION
# Get these from: https://dashboard.plaid.com
# ============================================

# Your Plaid Client ID (from Plaid Dashboard → Team Settings → Keys)
PLAID_CLIENT_ID=6a223ffcf849f7000d5ea58e

# Your Plaid Secret (use Sandbox secret for testing, Development for real Chase)
PLAID_SECRET=a2cd9a2d0d3c2100462489f2b5af98

# Plaid environment: sandbox | development | production
# Start with "sandbox" — switch to "development" when Plaid approves your app
PLAID_ENV=sandbox

# ============================================
# DATABASE
# ============================================

# Where to store the SQLite database file
# On Railway: mount a volume at /data and use /data/budget.db
DB_PATH=/data

# ============================================
# APP
# ============================================

# The public URL of your app (needed for PWA)
NEXT_PUBLIC_APP_URL=https://your-app.railway.app

# Node environment
NODE_ENV=production
